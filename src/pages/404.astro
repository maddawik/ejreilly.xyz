---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page doesn't exist.">
  <p class="alert mono" aria-hidden="true">
    !
  </p>
  <h1>Snake? Snake?! SNAAAAAKE!</h1>
  <p class="muted">404, page not found.</p>
  <p>
    <a href="/">Continue</a>
  </p>
</Base>

<style>
  .alert {
    margin: 0 0 0.25rem;
    color: var(--alert);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1;
  }
</style>
