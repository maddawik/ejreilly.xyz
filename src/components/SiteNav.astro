---
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname;
const links = [
  { href: "/", label: "About", active: path === "/" },
  { href: "/writing/", label: "Writing", active: path.startsWith("/writing") },
];
---

<nav aria-label="Site">
  <ul>
    {links.map((link) => (
      <li>
        <a href={link.href} aria-current={link.active ? "page" : undefined}>
          {link.label}
        </a>
      </li>
    ))}
  </ul>
  <ThemeToggle />
</nav>

<style>
  nav {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  ul {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
  }

  li + li {
    margin-top: 0.375rem;
  }

  a {
    position: relative;
    color: var(--fg-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent-hover);
  }

  a[aria-current="page"] {
    color: var(--accent);
  }

  a[aria-current="page"]::before {
    content: "";
    position: absolute;
    left: -0.875rem;
    top: 50%;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: currentColor;
    transform: translateY(-50%);
  }

  @media (max-width: 48rem) {
    nav {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    ul {
      display: flex;
      gap: 1.25rem;
      margin: 0;
    }

    li + li {
      margin-top: 0;
    }

    nav > :global(.theme-toggle) {
      margin-left: auto;
    }

    a[aria-current="page"]::before {
      display: none;
    }
  }
</style>
