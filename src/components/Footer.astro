---
import { SOCIALS } from "../consts";

const year = new Date().getFullYear();
---

<footer class="mono">
  <span>© {year} EJ Reilly</span>
  <ul>
    {SOCIALS.map((s) => (
      <li>
        <a href={s.href}>{s.name.toLowerCase()}</a>
      </li>
    ))}
  </ul>
</footer>

<style>
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 5rem;
    padding-top: 1.5rem;
    padding-bottom: 3rem;
    border-top: 1px solid var(--rule);
    color: var(--fg-muted);
    font-size: 0.8125rem;
  }

  ul {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li + li {
    margin-top: 0;
  }

  a {
    color: var(--fg-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent-hover);
  }
</style>
